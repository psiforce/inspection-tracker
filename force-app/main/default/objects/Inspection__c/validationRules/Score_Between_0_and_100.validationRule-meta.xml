<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Score_Between_0_and_100</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Score__c)), OR(Score__c &lt; 0, Score__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Score__c</errorDisplayField>
    <errorMessage>Enter a score from 0 to 100.</errorMessage>
</ValidationRule>
